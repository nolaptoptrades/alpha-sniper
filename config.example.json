  "_comment": "NLT Alpha Sniper — config.json. All tuneable values live here. Never hardcode paths or thresholds in scripts.",
  "_meta": {
    "version": "1.0.0",
    "changelog": {
      "0.1.0": "paths.py + config.json foundation",
      "0.2.0": "discovery.py, safety.py, sensor.py ported",
      "0.3.0": "simulator.py ported",
      "0.4.0": "brain.py ported — scoring, fast_track, brain blocks added; ML/KNN/curator/shadow blocks removed",
      "0.5.0": "manager.py manager_config.py stats_reader.py ported",
      "0.6.0": "dex_api.py + whale_api.py added; safety.py updated — min_buys_bands + whale ceiling moved to config; credentials block added",
      "0.7.0": "sensor.py + simulator.py update fetch to dex_api.py",
      "0.7.1": "fix missing shadow_ticks path in config.json",
      "0.7.2": "sensor set minmomhard was 3.0 - 0.0, discovery 90 to 10, live test only safety: liq, mom, vol from hard to warn, brain: min score from 60 to 30",
      "0.7.3": "evolved plan, free tier live mode unlock every sources with time limit, plan to update source add moralis, so it becomes 1. Helius, 2. moralis, 3.dexscreener. plan is recorded in  plan v.0.7.3",
      "0.7.4": "post_mortem.py + sync.py stub + rug_tracer.py ported; post_mortem and data blocks added to config; post mortem stack operational",
      "0.7.5": "update brain with its own hardgate param",
      "0.8.0": "multi-launchpad discovery (helius): pumpswap, launchlab, boop, moonshot, meteora_dbc; per-program cursor; launchpad field flows through pipeline; wallet_brain AMM list expanded (launchlab, raydium CLMM, boop.fun)",
      "0.9.0": "rebuilding component for better stability referencing code and logic from v0.8.0",
      "0.9.1": "pivot to create better TUI and deliver v1 as terminal first SaaS",
      "0.9.2": "add error_log path; fix shadow_state path typo (logs/state -> state)",
      "0.9.3": "remove dead free_tier block from discovery; EULA sync to D1 (nlt_db); log cleanup across all pipeline components; log_error() helper in paths.py",
      "0.9.4": "license system removed; open source release prep; CLI stats commands (--mystats, --insights, --export, --storage, --clear-cache, --clear-trades); config editor TUI; bridge bot signals; D1 curator + KV aggregates",
      "1.0.0": "first public open source release — full pipeline operational, paper trading validated, sync + aggregate data layer live"
    }
  },
